rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to safely get the authenticated user's role
    function getAuthUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Safely check if userDoc is null before accessing its data
      return userDoc != null ? userDoc.data.role : null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Public read for seller profiles
      allow create: if request.auth != null; // Any authenticated user can register
      allow update: if request.auth != null && request.auth.uid == userId; // Users update their own profile
    }

    // *** TEMPORARY ULTRA-PERMISSIVE DIAGNOSTIC RULES ***
    // *** NOT FOR PRODUCTION - ANY AUTHENTICATED USER CAN WRITE ***
    // Products collection
    match /products/{productId} {
      allow read: if true; // Public read
      allow write: if request.auth != null; // TEMPORARY: Any authenticated user can write to products
    }

    // Dishes collection
    match /dishes/{dishId} {
       allow read: if true; // Public read
       allow write: if request.auth != null; // TEMPORARY: Any authenticated user can write to dishes
    }

    // Orders collection
    match /orders/{orderId} {
      allow create: if request.auth != null; // Any authenticated user can create an order (buyer) - confirmed working

      // Allow read if authenticated AND (is buyer, or is seller of items, or is admin)
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.buyerId || 
        resource.data.sellerIds.hasAny([request.auth.uid]) || 
        getAuthUserRole() == 'admin'
      );

      // Allow update if authenticated AND (is seller of items, or is admin)
      allow update: if request.auth != null && (
        (resource.data.sellerIds.hasAny([request.auth.uid]) && getAuthUserRole() == 'seller') ||
        getAuthUserRole() == 'admin'
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      // TEMPORARY COMPROMISE: Allow client-side creation for now. (Critical for order flow)
      allow create: if request.auth != null;
    }

    // Admin Logs collection
    match /admin_logs/{logId} {
      allow read: if request.auth != null && getAuthUserRole() == 'admin'; // Only admins can read
      allow write: if false; // Only backend can write logs
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true; // Public read
      allow write: if false; // Not client-writable
    }
  }
}